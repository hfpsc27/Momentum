@page "/semestres/create"
@using Microsoft.EntityFrameworkCore
@using Momentum.UI.Models
@inject IDbContextFactory<Momentum.UI.Data.AppDbContext2> DbFactory
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Novo semestre</PageTitle>

<h2>Novo Semestre</h2>
<hr />

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}

<div class="row">
    <div class="col-md-4">
        <div class="mb-3">
            <label for="includeSaturday" class="form-label">Incluir @DayOfWeek.Saturday:</label>
            <InputCheckbox id="includeSaturday" @bind-Value="includeSaturday" @onchange="OnIncludeSaturdayChanged" @bind-Value:after="OnIncludeSaturdayChanged" class="form-check-inline" />
            @if (includeSaturday)
            {
                <span class="badge text-bg-success">@includeSaturday</span>
            }
        </div>

        <div class="mb-3">
            <label for="includeSunday" class="form-label">Incluir @DayOfWeek.Sunday:</label>
            <InputCheckbox id="includeSunday" @bind-Value="includeSunday" @onchange="OnIncludeSaturdayChanged" @bind-Value:after="OnIncludeSaturdayChanged" class="form-check-inline" />
            @if (includeSunday)
            {
                <span class="badge text-bg-success">@includeSunday</span>
            }
        </div>

        <EditForm method="post" Model="Semestres" OnValidSubmit="AddSemestres" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="descricao" class="form-label">Descricao:</label>
                <InputText id="descricao" @bind-Value="Semestres.Descricao" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Semestres.Descricao" class="text-danger" />
            </div>
            @*<div class="mb-3">
                    <label for="dtini" class="form-label">DtIni:</label>
                    <InputNumber id="dtini" @bind-Value="Semestres.DtIni" class="form-control" />
                    <ValidationMessage For="() => Semestres.DtIni" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dtfim" class="form-label">DtFim:</label>
                    <InputNumber id="dtfim" @bind-Value="Semestres.DtFim" class="form-control" />
                    <ValidationMessage For="() => Semestres.DtFim" class="text-danger" />
                </div>*@

            <div class="mb-3">
                <label for="dtini" class="form-label">Início:</label>
                <InputSelect id="dtini" class="form-control" @bind-Value="Semestres.DtIni">
                    <option value="">-- Selecione uma data de início --</option>
                    @foreach (var data in Datas)
                    {
                        <option value="@data.Id">@(data.Data.ToString() + " " + data.Data.DayOfWeek)</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Semestres.DtIni" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="dtfim" class="form-label">Fim:</label>
                <InputSelect id="dtfim" class="form-control" @bind-Value="Semestres.DtFim">
                    <option value="">-- Selecione uma data de fim --</option>
                    @foreach (var data in Datas)
                    {
                        <option value="@data.Id">@data.Data</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Semestres.DtFim" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Gravar</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/semestres">Voltar</a>
</div>

@code {
    public string ErrorMessage { get; set; } = string.Empty;

    //public bool IncludeSaturday { get; set; } = false;

    bool includeSaturday = true;
    bool includeSunday = false;

    [SupplyParameterFromForm]
    private Semestres Semestres { get; set; } = new();

    public List<Datas> Datas { get; set; } = new();
    public List<Datas> AllDatas { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        AllDatas = await context.Datas.ToListAsync();

        RemoveWeekendDays(includeSaturday, includeSunday);

        //Datas = includeSaturday ? AllDatas : AllDatas.Where(d => d.Data.DayOfWeek != DayOfWeek.Saturday).ToList();
    }

    private void OnIncludeSaturdayChanged()
    {
        RemoveWeekendDays(includeSaturday, includeSunday);
        //Datas = includeSaturday == true ? AllDatas : AllDatas.Where(d => d.Data.DayOfWeek != DayOfWeek.Saturday).ToList();
    }

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddSemestres()
    {
        using var context = DbFactory.CreateDbContext();
        try
        {
            context.Semestres.Add(Semestres);
            await context.SaveChangesAsync();
            NavigationManager.NavigateTo("/semestres");
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            if (ex.InnerException != null && ex.InnerException.Message.Contains("UNIQUE"))
            {
                ErrorMessage = "Este semestre já está registado.";
            }
            else
            {
                ErrorMessage = ex.Message;
            }
        }
    }

    private void RemoveWeekendDays(bool includeSaturday, bool includeSunday)
    {
        if (includeSaturday is false && includeSunday is false)
        {
            Datas = AllDatas.Where(d => d.Data.DayOfWeek != DayOfWeek.Saturday && d.Data.DayOfWeek != DayOfWeek.Sunday).ToList();
        }
        else if (includeSaturday is false && includeSunday is true)
        {
            Datas = AllDatas.Where(d => d.Data.DayOfWeek != DayOfWeek.Saturday).ToList();
        }
        else if (includeSaturday is true && includeSunday is false)
        {
            Datas = AllDatas.Where(d => d.Data.DayOfWeek != DayOfWeek.Sunday).ToList();
        }
        else if (includeSaturday is true && includeSunday is true)
        {
            Datas = AllDatas;
        }
    }
}
