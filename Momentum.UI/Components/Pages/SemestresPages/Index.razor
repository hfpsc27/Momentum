@page "/semestres"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Momentum.UI.Models
@using Momentum.UI.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Momentum.UI.Data.AppDbContext2> DbFactory
@rendermode InteractiveServer

<PageTitle>Semestres</PageTitle>

<h2>Semestres</h2>
<hr />

<p>
    <a href="semestres/create" class="btn btn-sm btn-outline-primary">➕ Criar semestre</a>
</p>

<QuickGrid Class="table" Items="context.Semestres.Include(d => d.DtIniNavigation).Include(d => d.DtFimNavigation)">
    <PropertyColumn Property="semestres => semestres.Descricao" Sortable="true" />
    <PropertyColumn Property="semestres => semestres.DtIniNavigation.Data" Sortable="true" Title="Início" Class="text-success" />
    <PropertyColumn Property="semestres => semestres.DtFimNavigation.Data" Sortable="true" Title="Fim" Class="text-danger" />

    <TemplateColumn Context="semestres">
        <div class="btn-group" role="group" aria-label="opGroup">
            <a href="@($"semestres/edit?id={semestres.Id}")" class="btn btn-sm btn-outline-primary">✏️</a>
            <a href="@($"semestres/details?id={semestres.Id}")" class="btn btn-sm btn-outline-primary">🔍</a>
            <a href="@($"semestres/delete?id={semestres.Id}")" class="btn btn-sm btn-outline-danger">🗑️</a>
        </div>
    </TemplateColumn>
</QuickGrid>

@code {
    private AppDbContext2 context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
