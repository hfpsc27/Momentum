@page "/docentes/create"
@using Microsoft.EntityFrameworkCore
@using Momentum.UI.Models
@using MudBlazor
@inject IDbContextFactory<Momentum.UI.Data.AppDbContext2> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<MudPaper Class="pa-5 mt-2 d-flex justify-space-between">
    <MudText Typo="Typo.h5" Align="Align.Left">Novo docente</MudText>
    @*<MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" href="docentes/create">Novo</MudButton>*@
</MudPaper>


<MudPaper Class="pa-5 mt-2">
    @if (!String.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error">@ErrorMessage</MudAlert>
    }

    <EditForm method="post" Model="@Docentes" OnValidSubmit="AddDocentes" FormName="create" Enhance>
        <DataAnnotationsValidator />
        <MudCardContent>
            <MudTextField Label="Nome" HelperText="Nome completo"
                          @bind-Value="Docentes.Nome" For="@(() => Docentes.Nome)"
                          RequiredError="Nome obrigatório" 
                          ErrorText="Nome obrigatório"/>
            <MudTextField Label="Email" Class="mt-3"
                          @bind-Value="Docentes.Email" For="@(() => Docentes.Email)"
                          ErrorText="Email obrigatório" />
        </MudCardContent>
        <MudCardActions Class="d-flex justify-end">
            <MudButton Href="/docentes" Variant="Variant.Text" Color="Color.Surface" Class="mr-1">Cancelar</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Gravar</MudButton>
        </MudCardActions>
    </EditForm>
</MudPaper>

