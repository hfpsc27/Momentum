@page "/docentes"
@using Microsoft.EntityFrameworkCore
@*@using Microsoft.AspNetCore.Components.QuickGrid*@
@using Momentum.UI.Models
@using Momentum.UI.Data
@using MudBlazor
@implements IAsyncDisposable
@inject IDbContextFactory<Momentum.UI.Data.AppDbContext2> DbFactory
@rendermode InteractiveServer

<PageTitle>Index</PageTitle>

<MudPaper Class="pa-5 mt-2 d-flex justify-space-between">
    <MudText Typo="Typo.h5" Align="Align.Left">Docentes</MudText>
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" href="docentes/create">Novo</MudButton>
</MudPaper>

<MudPaper Class="pa-5 mt-2">
    <MudDataGrid T="Docentes" Items="@FilteredDocentes" QuickFilter="@_quickFilter" Elevation="0" Dense="true" Hover="true">

        <ToolBarContent>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Pesquisar" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>

        <Columns>
            <PropertyColumn Property="x => x.Id" />
            <PropertyColumn Property="x => x.Nome" />
            <PropertyColumn Property="x => x.Email" />
            <TemplateColumn CellClass="d-flex justify-end">
                <CellTemplate Context="docente">
                    <MudButtonGroup Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="false">
                        <MudLink Href="@($"docentes/edit?id={docente.Item.Id}")">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Surface"></MudIconButton>
                        </MudLink>
                        <MudLink Href="@($"docentes/details?id={docente.Item.Id}")">
                            <MudIconButton Icon="@Icons.Material.Filled.FileCopy" Color="Color.Surface"></MudIconButton>
                        </MudLink>
                        <MudLink Href="@($"docentes/delete?id={docente.Item.Id}")">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"></MudIconButton>
                        </MudLink>
                    </MudButtonGroup>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="Docentes" RowsPerPageString="Linhas por página" />
        </PagerContent>
    </MudDataGrid>
</MudPaper>

@*<p>
        <a href="docentes/create" class="btn btn-sm btn-outline-primary">Novo docente</a>
    </p>*@

